diff --git a/tv-home/android/app/src/main/java/app/couchtv/launcher/Resume.kt b/tv-home/android/app/src/main/java/app/couchtv/launcher/Resume.kt
new file mode 100644
index 0000000..e71d69f
--- /dev/null
+++ b/tv-home/android/app/src/main/java/app/couchtv/launcher/Resume.kt
@@ -0,0 +1,72 @@
+package app.couchtv.launcher
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.media.tv.TvContract
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+
+/**
+ * local change: "When the TV turns on: last used". The home remembers the last input (Airtel's box
+ * on HDMI 1, a channel from the Channels row) or app it opened, and when the TV wakes from standby
+ * or finishes starting it opens that again, so the TV comes back where it was instead of on a home
+ * screen. Off in Home settings (Look and scenes) puts the home back as the first screen.
+ */
+object Resume {
+    private const val TAG = "couch-tv"
+    private const val PREF = "resume"
+    private const val WAKE_DELAY_MS = 3_000L    // let the TV's own wake-up (and the Home button watch) settle first
+    private const val BOOT_DELAY_MS = 25_000L   // after a restart the inputs take a while to come up
+    private val main = Handler(Looper.getMainLooper())
+    private var registered = false
+
+    private fun prefs(c: Context) = c.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+
+    fun enabled(c: Context): Boolean = prefs(c).getBoolean("on", true)
+    fun setEnabled(c: Context, on: Boolean) { prefs(c).edit().putBoolean("on", on).apply() }
+
+    /** What the home just opened: "input" + a TV input id, or "app" + a package name. */
+    fun remember(c: Context, kind: String, id: String) {
+        if (id.isBlank() || id == c.packageName || id == "com.android.tv.settings") return
+        prefs(c).edit().putString("kind", kind).putString("id", id).putLong("at", System.currentTimeMillis()).apply()
+    }
+
+    /** The home itself came forward on purpose (Home pressed): the TV turns on where it was left anyway. */
+    fun start(c: Context) {
+        if (registered) return
+        registered = true
+        val app = c.applicationContext
+        val f = IntentFilter(Intent.ACTION_SCREEN_ON)
+        app.registerReceiver(object : BroadcastReceiver() {
+            override fun onReceive(ctx: Context, i: Intent) { later(app, WAKE_DELAY_MS) }
+        }, f)
+    }
+
+    fun afterBoot(c: Context) = later(c.applicationContext, BOOT_DELAY_MS)
+
+    private fun later(c: Context, ms: Long) {
+        main.removeCallbacksAndMessages(this)
+        main.postAtTime({ open(c) }, this, android.os.SystemClock.uptimeMillis() + ms)
+    }
+
+    private fun open(c: Context) {
+        if (!enabled(c) || CrashGuard.standingAside(c)) return
+        val p = prefs(c)
+        val kind = p.getString("kind", null) ?: return
+        val id = p.getString("id", null) ?: return
+        val i = when (kind) {
+            "input" -> Intent(Intent.ACTION_VIEW, TvContract.buildChannelUriForPassthroughInput(id))
+            "app" -> c.packageManager.getLeanbackLaunchIntentForPackage(id) ?: c.packageManager.getLaunchIntentForPackage(id)
+            else -> null
+        } ?: return
+        try {
+            c.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            Log.i(TAG, "resume: opened the last used $kind")
+        } catch (e: Exception) {
+            Log.w(TAG, "resume: could not open the last used $kind: $e")
+        }
+    }
+}
