@@ -241,7 +241,16 @@ body {
 .caption span { display: block; font-size: 1.4375rem; line-height: 1.875rem; color: var(--text-2); }
 
 /* ---------- apps ---------- */
-.apps { position: absolute; left: var(--safe-x); right: var(--safe-x); top: 37.5rem; }
+.apps { position: absolute; left: var(--safe-x); right: var(--safe-x); top: 37.5rem; transition: transform 200ms var(--ease); }   /* local change: More apps slides up (keepGridInView) */
+/* local change: Classic keeps its row of apps along the bottom of the screen, not the middle */
+/* (held by its bottom edge, so a second row of apps or More apps grows upwards, not off the screen) */
+html:not(.theme-night):not(.theme-oled) .apps { top: auto; bottom: 5.5rem; }
+/* local change: big tiles on Classic, six a row (home, All apps, the Channels row) */
+html:not(.theme-night):not(.theme-oled) { --app-w: 16.6rem; --app-h: 9.35rem; }
+html:not(.theme-night):not(.theme-oled) .grid { grid-template-columns: repeat(6, var(--app-w));
+  column-gap: 2rem; grid-column-gap: 2rem; row-gap: 3.25rem; grid-row-gap: 3.25rem; }
+html:not(.theme-night):not(.theme-oled) .app .face.icon img { width: 5rem; height: 5rem; }
+html:not(.theme-night):not(.theme-oled) .app .label { font-size: 1.4375rem; line-height: 1.75rem; }
 .grid {
   display: grid; grid-template-columns: repeat(8, var(--app-w)); grid-auto-rows: var(--app-h);
   column-gap: var(--gap); row-gap: var(--app-row-gap);
@@ -1925,3 +1934,140 @@ html:not(.kids-on) .kids { display: none; }
 }
 
 
+
+/* ================= local change: Channels row (home.channels) =================
+   Channel cards the width of an app tile, so eight sit over the eight apps: the channel's logo on
+   white, its number and name underneath. A channel without a logo shows its number big. */
+html.chan-row .shelf-track { gap: 2rem; }
+.ccard.chan { width: var(--app-w); height: calc(var(--app-h) + 3rem); }
+.ccard.chan.focus { transform: scale(1.1); }
+.ccard.chan .face { border-radius: 0.75rem; background: rgba(255, 255, 255, 0.12); }
+.ccard.chan.has-img .face { background: #fff; }
+.ccard.chan .face img {
+  top: 0.625rem; left: 0.75rem; width: calc(100% - 1.5rem); height: 5.5rem; object-fit: contain;
+}
+.ccard.chan .cwords, .ccard.chan.has-img .cwords {
+  display: flex; align-items: baseline; gap: 0.5rem; padding: 0.375rem 0.75rem 0.5rem;
+  background: rgba(10, 8, 12, 0.86); border-radius: 0 0 0.75rem 0.75rem;
+}
+.ccard.chan .cvalue { font-size: 1.375rem; line-height: 1.75rem; flex: none; }
+.ccard.chan .cwords b { font-size: 1.125rem; line-height: 1.75rem; min-width: 0; }
+.ccard.chan:not(.has-img) .cwords { top: 0; flex-direction: column; justify-content: center; align-items: flex-start; background: none; }
+.ccard.chan:not(.has-img) .cvalue { font-size: 2.5rem; line-height: 3rem; }
+
+/* ================= local change: Airtel colours (home.airtel_theme), Classic only =================
+   A dark red background in place of the photos, red highlights on what has the focus. */
+html.theme-airtel { --bg: #0b0204; }
+html.theme-airtel .bg img, html.theme-airtel .bgvid, html.theme-airtel .scenes,
+html.theme-airtel .ambient-lighting, html.theme-airtel .weather-canvas, html.theme-airtel .place { display: none; }
+html.theme-airtel .scrim {
+  background:
+    radial-gradient(110% 85% at 88% -12%, rgba(228, 0, 0, 0.62) 0%, rgba(140, 0, 20, 0.34) 38%, rgba(11, 2, 4, 0) 72%),
+    radial-gradient(70% 60% at 0% 110%, rgba(228, 0, 0, 0.22) 0%, rgba(11, 2, 4, 0) 70%),
+    linear-gradient(180deg, #1c0409 0%, #0b0204 100%);
+}
+html.theme-airtel .app.focus .face, html.theme-airtel .tile.focus .face {
+  box-shadow: 0 0 0 0.25rem #ff2a2a, 0 1.5rem 3rem rgba(228, 0, 0, 0.32);
+}
+html.theme-airtel .qbtn.focus { background: #e40000; color: #fff; }
+html.theme-airtel .shelf-head h2 { color: #fff; }
+html.theme-airtel .ccard.chan:not(.has-img) .face { background: linear-gradient(135deg, #e40000 0%, #7a0012 100%); }
+html.theme-airtel .ccard.chan .cwords { background: rgba(120, 0, 16, 0.92); }
+html.theme-airtel .ccard.chan:not(.has-img) .cwords { background: none; }
+
+/* local change: on Classic the Channels row sits just above the apps along the bottom, the photo and
+   the clock keep the top of the screen; it steps aside while More apps is open */
+html.chan-row:not(.theme-night):not(.theme-oled) .shelf { top: auto; bottom: calc(7.75rem + var(--apps-h, 7rem)); }   /* --apps-h: app.js, the row of apps under it */
+html.chan-row.expanded:not(.theme-night):not(.theme-oled) .shelf { visibility: hidden; }
+html.chan-row .shelf-head h2 { margin-bottom: 0.75rem; }
+
+/* local change: the All channels card (end of the Channels row) */
+.ccard.allch-card .face { background: rgba(255, 255, 255, 0.16); display: flex; align-items: center; justify-content: center; }
+.ccard.allch-card .cwords { position: static; display: block; background: none; text-align: center; padding: 0 0.75rem; }
