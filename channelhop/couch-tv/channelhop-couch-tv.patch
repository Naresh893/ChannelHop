+.ccard.allch-card .face::before {
+  content: ""; display: block; position: absolute; top: 1.5rem; left: 50%; width: 2.25rem; height: 2.25rem; margin-left: -1.125rem;
+  background:
+    linear-gradient(#fff, #fff) 0 0 / 0.875rem 0.875rem no-repeat, linear-gradient(#fff, #fff) 100% 0 / 0.875rem 0.875rem no-repeat,
+    linear-gradient(#fff, #fff) 0 100% / 0.875rem 0.875rem no-repeat, linear-gradient(#fff, #fff) 100% 100% / 0.875rem 0.875rem no-repeat;
+  opacity: 0.9;
+}
+.ccard.allch-card .cwords { margin-top: 3rem; }
+html.theme-airtel .ccard.allch-card .face { background: linear-gradient(135deg, #e40000 0%, #7a0012 100%); }
+
+/* local change: All channels, a full screen grid of channel cards over the home */
+.allch {
+  position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; display: none; flex-direction: column;
+  background: rgba(8, 6, 10, 0.96); padding: 3.25rem var(--safe-x) 0;
+}
