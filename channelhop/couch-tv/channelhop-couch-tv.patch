+.allch-grid {
+  flex: 1; min-height: 0; overflow: hidden; position: relative;
+  display: grid; grid-template-columns: repeat(6, var(--app-w)); grid-auto-rows: calc(var(--app-h) + 3rem);
+  column-gap: 1.5rem; row-gap: 1.5rem; grid-column-gap: 1.5rem; grid-row-gap: 1.5rem;
+  padding: 0.75rem 0.5rem 3rem; margin: 0 -0.5rem; scroll-behavior: auto;   /* smooth scrolling is ignored on this hidden-scroll box */
+}
+.allch-grid .ccard.chan { width: auto; }
+.allch-grid .ccard.chan.focus .face { box-shadow: 0 0 0 0.25rem #fff, 0 1rem 2rem rgba(0, 0, 0, 0.5); }
+html.theme-airtel .allch { background: rgba(20, 2, 6, 0.97); }
+html.theme-airtel .allch-grid .ccard.chan.focus .face { box-shadow: 0 0 0 0.25rem #ff2a2a, 0 1rem 2rem rgba(228, 0, 0, 0.3); }
+html.theme-airtel .allch-tab.focus { background: #e40000; color: #fff; }
+
+/* local change: neater channel cards: the name first and in full, the number small and grey on the
+   right, HD as a small badge on the logo; and no photo credit line under the date on Classic */
+.ccard.chan .cwords, .ccard.chan.has-img .cwords { justify-content: space-between; gap: 0.5rem; padding: 0.4375rem 0.75rem 0.5rem; }
+.ccard.chan .cwords b { order: 1; flex: 1; font-size: 1.1875rem; font-weight: 620; color: #fff; }
+.ccard.chan .cvalue { order: 2; font-size: 1rem; font-weight: 500; color: rgba(255, 255, 255, 0.55); }
+.ccard.chan:not(.has-img) .cvalue { order: 0; font-size: 2.5rem; color: #fff; }
+.ccard.chan .chd {
+  position: absolute; top: 0.4375rem; right: 0.4375rem; padding: 0.0625rem 0.375rem; border-radius: 0.3125rem;
+  font-size: 0.8125rem; line-height: 1.125rem; font-weight: 750; letter-spacing: 0.04em;
+  background: rgba(10, 8, 12, 0.78); color: #fff;
+}
+html:not(.theme-night):not(.theme-oled).chan-row .place { display: none; }
+
+/* local change: Lights menu, the colour dot on the Colour row */
+.lswatch { display: inline-block; width: 1.125rem; height: 1.125rem; border-radius: 50%; margin-left: 0.625rem; vertical-align: -0.125rem;
+  box-shadow: 0 0 0 0.125rem rgba(255, 255, 255, 0.6); }
+
+/* local change: Classic's All apps button (the More apps tile), drawn like the All channels card */
+.face.tool.allapps { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.375rem; }
+.face.tool.allapps span { font-size: 1.25rem; line-height: 1.5rem; font-weight: 650; color: #fff; }
+.allapps-ic {
+  display: block; width: 1.875rem; height: 1.875rem;
+  background:
+    linear-gradient(#fff, #fff) 0 0 / 0.75rem 0.75rem no-repeat, linear-gradient(#fff, #fff) 100% 0 / 0.75rem 0.75rem no-repeat,
+    linear-gradient(#fff, #fff) 0 100% / 0.75rem 0.75rem no-repeat, linear-gradient(#fff, #fff) 100% 100% / 0.75rem 0.75rem no-repeat;
+  opacity: 0.9;
+}
+
+/* local change: the All channels tile inside All apps (IPTV logo and words) */
+.face.tool.allch-app { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem;
+  background: linear-gradient(135deg, #c8102e 0%, #6e0a1d 100%); }
+.face.tool.allch-app .iptv-ic { width: 3.25rem; height: 2.3rem; }
+.face.tool.allch-app span { font-size: 1.1875rem; line-height: 1.375rem; font-weight: 650; color: #fff; }
+.app .face.tool.allch-app svg.iptv-ic { width: 3.25rem; height: 2.3rem; stroke: none; }
+.app .face.tool.allch-app svg.iptv-ic path { stroke: #fff; }
+html .app .face.tool.allch-app { background: linear-gradient(135deg, #c8102e 0%, #6e0a1d 100%) !important; }
+.app .face.tool.allch-app svg.iptv-ic { width: 4rem; height: 2.85rem; }
+
+/* local change: bigger channel cards to match the six-a-row tiles: a taller logo, larger words */
+.ccard.chan .face img { top: 0.75rem; left: 1rem; width: calc(100% - 2rem); height: calc(100% - 4.25rem); }
+.ccard.chan .cwords, .ccard.chan.has-img .cwords { padding: 0.5rem 0.875rem 0.625rem; }
+.ccard.chan .cwords b { font-size: 1.4375rem; line-height: 2rem; }
+.ccard.chan .cvalue { font-size: 1.1875rem; }
+.ccard.chan .chd { font-size: 1rem; line-height: 1.375rem; padding: 0.0625rem 0.5rem; }
+.ccard.allch-card .cwords b { font-size: 1.6875rem; }
+.allch-grid { column-gap: 2rem; grid-column-gap: 2rem; row-gap: 2rem; grid-row-gap: 2rem; }
+/* local change: while All apps is open on Classic the clock panel steps aside, so the tiles get the screen */
+html.expanded:not(.theme-night):not(.theme-oled) header.top { opacity: 0; transition: opacity 200ms; }
