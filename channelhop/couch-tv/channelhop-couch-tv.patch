diff --git a/tv-home/android/app/src/main/java/app/couchtv/launcher/Lights.kt b/tv-home/android/app/src/main/java/app/couchtv/launcher/Lights.kt
new file mode 100644
index 0000000..faccdd0
--- /dev/null
+++ b/tv-home/android/app/src/main/java/app/couchtv/launcher/Lights.kt
@@ -0,0 +1,101 @@
+package app.couchtv.launcher
+
+import android.content.Context
+import android.util.Base64
+import android.util.Log
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * local change: the Lights quick button. Talks to the household's own bulb service (a Lambda in
+ * front of the Halonix/Tuya bulb): POST /api/power {on}, /api/white {brightness, temp},
+ * /api/colour {h, s, v}, GET /api/state, each with "Authorization: Bearer <token>". The token
+ * comes from POST /api/login {password}; the app signs in again by itself when it is refused.
+ *
+ * The service's address and password come from the household's own sign-in script on their
+ * computer ("light_b64": base64 JSON {url, password}) and live in this app's private settings
+ * only, never in the page. Only those four paths can be called.
+ */
+object Lights {
+    private const val TAG = "couch-tv"
+    private const val PREF = "lights"
+    private val PATHS = setOf("/api/power", "/api/white", "/api/colour", "/api/state")
+    private val busy = AtomicBoolean(false)
+
+    fun readExtras(c: Context, b64: String?) {
+        if (b64 == null) return
+        val e = c.getSharedPreferences(PREF, Context.MODE_PRIVATE).edit()
+        if (b64.isBlank() || b64 == "none") { e.clear().apply(); return }
+        try {
+            val j = JSONObject(String(Base64.decode(b64, Base64.DEFAULT), Charsets.UTF_8))
+            val url = j.getString("url").trim().trimEnd('/')
+            if (!Regex("^https://[A-Za-z0-9.-]{1,200}$").matches(url)) return
+            e.putString("url", url).putString("password", j.optString("password", "")).remove("token").apply()
+        } catch (x: Exception) {
+            Log.w(TAG, "lights: settings refused: $x")
+        }
+    }
+
+    fun ready(c: Context): Boolean = c.getSharedPreferences(PREF, Context.MODE_PRIVATE).getString("url", null) != null
+
+    /** Sends one command in the background; done(ok, json reply or error text). False: not set up or busy. */
+    fun send(c: Context, path: String, body: String, done: (Boolean, String) -> Unit): Boolean {
+        if (path !in PATHS) return false
+        val p = c.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+        val base = p.getString("url", null) ?: return false
+        val payload = if (path == "/api/state") null else try { JSONObject(body).toString() } catch (_: Exception) { return false }
+        if (!busy.compareAndSet(false, true)) return false
+        Thread {
+            var ok = false
+            var out = ""
+            try {
+                var token = p.getString("token", null)
+                if (token == null) token = login(base, p.getString("password", "") ?: "")?.also { p.edit().putString("token", it).apply() }
+                var r = call(base + path, payload, token)
+                if (r.first == 401) {   // the sign-in ran out: once more with a fresh one
+                    token = login(base, p.getString("password", "") ?: "")?.also { p.edit().putString("token", it).apply() }
+                    r = call(base + path, payload, token)
+                }
+                ok = r.first in 200..299
+                out = r.second
+                if (!ok) Log.w(TAG, "lights: $path answered ${r.first}")
+            } catch (x: Exception) {
+                Log.w(TAG, "lights: $path failed: $x")
+                out = x.javaClass.simpleName
+            } finally {
+                busy.set(false)
+                done(ok, out)
+            }
+        }.apply { isDaemon = true; name = "lights" }.start()
+        return true
+    }
+
+    private fun login(base: String, password: String): String? {
+        if (password.isEmpty()) return null
+        val r = call("$base/api/login", JSONObject().put("password", password).toString(), null)
+        if (r.first !in 200..299) { Log.w(TAG, "lights: sign-in refused (${r.first})"); return null }
+        return try { JSONObject(r.second).optString("token").takeIf { it.isNotEmpty() } } catch (_: Exception) { null }
+    }
+
+    private fun call(url: String, body: String?, token: String?): Pair<Int, String> {
+        val c = URL(url).openConnection() as HttpURLConnection
+        try {
+            c.connectTimeout = 8000
+            c.readTimeout = 15000
+            c.requestMethod = if (body == null) "GET" else "POST"
+            if (token != null) c.setRequestProperty("Authorization", "Bearer $token")
+            if (body != null) {
+                c.doOutput = true
+                c.setRequestProperty("Content-Type", "application/json")
+                c.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            }
+            val code = c.responseCode
+            val text = (if (code >= 400) c.errorStream else c.inputStream)?.bufferedReader()?.use { it.readText() } ?: ""
+            return code to text.take(20000)
+        } finally {
+            c.disconnect()
+        }
+    }
+}
