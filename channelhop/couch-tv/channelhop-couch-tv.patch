index 0000000..f3f7ae8
--- /dev/null
+++ b/tv-home/tools/lights-signin.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""local change: sign the TV home's Lights button in to the household's bulb service.
+
+Run it yourself on this computer (it asks for the password and does not show or save it here):
+    TV_IP=192.168.1.50 .venv/bin/python tv-home/tools/lights-signin.py
+
+It checks the password with the service first, then hands the service's address and the password
+to the home app on the TV, which keeps them in its own private settings (Lights.kt) and signs in
+again by itself when needed. To take the Lights button's sign-in off the TV:
+    TV_IP=192.168.1.50 .venv/bin/python tv-home/tools/lights-signin.py --forget
+"""
+import base64
+import getpass
+import json
+import os
+import subprocess
+import sys
+import urllib.error
+import urllib.request
+
+URL = os.environ.get("LIGHTS_URL", "")
+HERE = os.path.dirname(os.path.abspath(__file__))
+HOME_ACT = "app.couchtv.launcher/.MainActivity"
+
+
+def tv(*args):
+    return subprocess.run([sys.executable, os.path.join(HERE, "tvadb.py"), *args], check=True,
+                          capture_output=True, text=True).stdout
+
+
+def ask_password():
+    """A Mac password box (the typing is hidden and never printed); a terminal prompt elsewhere."""
+    if sys.platform == "darwin" and "--terminal" not in sys.argv:
+        script = ('display dialog "Type the password of your Halonix bulb service. It goes only to the TV." '
+                  'with title "TV Lights sign-in" default answer "" with hidden answer '
+                  'buttons {"Cancel", "Sign in"} default button "Sign in"')
+        r = subprocess.run(["osascript", "-e", script, "-e", "text returned of result"],
+                           capture_output=True, text=True)
+        return r.stdout.rstrip("\n") if r.returncode == 0 else ""
+    return getpass.getpass("Bulb service password (not shown): ")
+
+
+def send(blob):
+    tv("shell", f"am start -n {HOME_ACT} --es light_b64 {blob}")
+
+
+def main():
+    if not os.environ.get("TV_IP"):
+        sys.exit("Set TV_IP first, for example: TV_IP=192.168.1.50")
+    if not URL and "--forget" not in sys.argv:
+        sys.exit("Set LIGHTS_URL to your bulb service's address first (it must offer /api/login).")
+    if "--forget" in sys.argv:
+        send("none")
+        print("The Lights sign-in is off the TV.")
+        return
+    pw = ask_password()
+    if not pw:
+        sys.exit("No password typed. Nothing was sent to the TV.")
+    req = urllib.request.Request(URL.rstrip("/") + "/api/login", data=json.dumps({"password": pw}).encode(),
+                                 headers={"Content-Type": "application/json"}, method="POST")
+    try:
+        with urllib.request.urlopen(req, timeout=20) as r:
+            ok = bool(json.loads(r.read().decode() or "{}").get("token"))
+    except urllib.error.HTTPError as e:
+        sys.exit(f"The bulb service refused that password ({e.code}). Nothing was sent to the TV.")
+    except Exception as e:
+        sys.exit(f"Could not reach the bulb service ({type(e).__name__}). Nothing was sent to the TV.")
+    if not ok:
+        sys.exit("The bulb service gave no sign-in. Nothing was sent to the TV.")
+    blob = base64.b64encode(json.dumps({"url": URL.rstrip("/"), "password": pw}).encode()).decode()
+    send(blob)
+    print("Signed in. The Lights button is on the TV's home now (top right, next to Input).")
+
+
+if __name__ == "__main__":
+    main()
